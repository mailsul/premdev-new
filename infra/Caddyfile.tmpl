# =====================================================================
# PremDev — Caddy reverse proxy (auto SSL via Cloudflare DNS-01 wildcard)
# =====================================================================

{
        email ${LE_EMAIL}
        # Use Cloudflare DNS plugin for wildcard certificates
        acme_dns cloudflare ${CF_API_TOKEN}
        servers {
                protocols h1 h2 h3
        }
}

# Extra domain snippets (one file per custom domain added via Admin panel).
# Generated by infra/caddy-add-domain.sh — do not edit manually.
# Files live in /opt/premdev/data/caddy/extra/ on the host,
# mounted into the container at /etc/caddy/extra/.
import /etc/caddy/extra/*.caddy

# Wildcard SSL for the entire domain (covers app, api, admin, db, +
# every workspace preview/deploy on `<project>-<user>.<domain>`)
*.${PRIMARY_DOMAIN}, ${PRIMARY_DOMAIN} {
        tls {
                dns cloudflare ${CF_API_TOKEN}
        }

        # phpMyAdmin -> db.<domain>
        @pma host db.${PRIMARY_DOMAIN}
        handle @pma {
                reverse_proxy phpmyadmin:80
        }

        # Adminer -> adminer.<domain>
        @adminer host adminer.${PRIMARY_DOMAIN}
        handle @adminer {
                reverse_proxy adminer:8080
        }

        # Root domain -> static "under construction" landing page.
        # Deliberately separated from the app so the apex hostname can be
        # used for marketing later without touching the IDE on app.<domain>.
        # The landing dir is bind-mounted from /opt/premdev/data/landing.
        @apex host ${PRIMARY_DOMAIN}
        handle @apex {
                root * /srv/landing
                try_files {path} /index.html
                file_server
        }

        # Main app -> app.<domain>. Long read timeout because
        # /ws/terminal/* is a long-lived WebSocket; the default 30s would
        # silently kill idle terminals.
        @app host app.${PRIMARY_DOMAIN}
        handle @app {
                reverse_proxy app:3001 {
                        transport http {
                                dial_timeout 10s
                                read_timeout 24h
                                write_timeout 24h
                        }
                        flush_interval -1
                }
        }

        # Admin alias (same backend, route handled in app)
        @admin host admin.${PRIMARY_DOMAIN}
        handle @admin {
                reverse_proxy app:3001 {
                        transport http {
                                dial_timeout 10s
                                read_timeout 24h
                                write_timeout 24h
                        }
                        flush_interval -1
                }
        }

        # Workspace preview/deploy: any subdomain in either of these shapes:
        #   - <project>-<user>.<domain>  (auto-generated default)
        #   - <custom>.<domain>          (single-component custom subdomain
        #                                 the user picks when running the
        #                                 workspace; collisions with reserved
        #                                 labels above are filtered in app)
        # is routed to the app, which looks up the matching workspace in
        # SQLite and reverse-proxies into the container. Workspaces are
        # always-on so this URL = deploy URL.
        #
        # Regex matches a single DNS label (2-50 chars, [a-z0-9-], no
        # leading/trailing hyphen). The reserved-label matchers above
        # (api/admin/db/...) take precedence because Caddy evaluates
        # @-named matchers in source order.

        # Static service subdomains — matched before the @workspace catch-all.
        # Add one @<name> + handle block here for each non-workspace service.
        # The gitea container must be on the premdev_net Docker network.
        # GITEA_SUBDOMAIN is read from .env (e.g. GITEA_SUBDOMAIN=gitea-maraazn069).
        # To change: update GITEA_SUBDOMAIN in /opt/premdev/.env, then regenerate
        # Caddyfile and reload Caddy (see perintah.md).
        # 9Router AI Gateway — router.${PRIMARY_DOMAIN}
        # Dashboard untuk konfigurasi provider AI (Anthropic, Gemini, OpenAI, dll).
        # Semua AI agent di workspace PremDev diarahkan lewat sini.
        @ninerouter host router.${PRIMARY_DOMAIN}
        handle @ninerouter {
                reverse_proxy 9router:20128 {
                        transport http {
                                dial_timeout 10s
                                read_timeout 5m
                                write_timeout 5m
                        }
                        flush_interval -1
                }
        }

        @gitea host ${GITEA_SUBDOMAIN}.${PRIMARY_DOMAIN}
        handle @gitea {
                reverse_proxy ${GITEA_CONTAINER_HOST}:${GITEA_PORT}
        }

        # 9Router AI gateway dashboard — admin-only.
        # Login uses 9Router's own INITIAL_PASSWORD (separate from PremDev accounts).
        # External tools (VS Code, Cursor) can use router.<domain>/v1 as base URL.
        @nine-router host router.${PRIMARY_DOMAIN}
        handle @nine-router {
                reverse_proxy 9router:20128 {
                        transport http {
                                dial_timeout 10s
                                read_timeout 24h
                                write_timeout 24h
                        }
                        flush_interval -1
                }
        }

        @workspace header_regexp workspace Host ^[a-z0-9](?:[a-z0-9_-]{0,48}[a-z0-9])?\.${PRIMARY_DOMAIN}(?::[0-9]+)?$
        handle @workspace {
                reverse_proxy app:3001 {
                        transport http {
                                dial_timeout 5s
                                # Long read/write timeouts are required for long-lived
                                # WebSocket connections (Socket.IO, terminals, etc.).
                                # response_header_timeout only guards the initial HTTP
                                # handshake; once the 101 is received Caddy tunnels raw
                                # bytes and these timeouts prevent mid-session drops.
                                read_timeout 24h
                                write_timeout 24h
                        }
                        # flush_interval -1 forces Caddy to flush response data
                        # immediately (no buffering). Critical for WebSocket upgrades,
                        # Socket.IO polling, and SSE — without it Caddy may hold back
                        # the 101 Switching Protocols or event-stream chunks.
                        flush_interval -1
                        header_up Host {host}
                        header_up X-Real-IP {remote}
                        header_up X-Forwarded-Proto https
                }
        }

        # Default catchall
        handle {
                respond "Unknown subdomain" 404
        }
}

# Note: legacy `*.${PREVIEW_DOMAIN}` and `*.${DEPLOY_DOMAIN}` blocks were
# removed — every workspace now uses the unified
# `<project>-<user>.${PRIMARY_DOMAIN}` URL handled by @workspace above.
